<?xml version="1.0" encoding="utf-8"?>
<Patch>
	
	<Operation Class="XmlExtensions.OptionalPatch">
		<modId>FrozenSnowFox.SimplySoil</modId>
		<key>FSFSimplySoilPlanterBoxes</key>
		<defaultValue>false</defaultValue>
		<caseTrue>
			
		<Operation Class="PatchOperationSequence">
			<success>Normal</success>
			<operations>
				
			<!-- Planter Boxes Require Soil -->
				
			<!-- Vanilla Furniture Expanded Farming -->
				
			<li MayRequire="VanillaExpanded.VFEFarming" Class="PatchOperationAdd">
				<xpath>/Defs/ThingDef[defName = "VFE_PlanterBox_Tilable"]</xpath>
				<value>
					<costList>
						<FSFItemSoil>5</FSFItemSoil>
					</costList>
				</value>
			</li>
				
			<li MayRequire="VanillaExpanded.VFEFarming" Class="PatchOperationAdd">
				<xpath>/Defs/ThingDef[defName = "VFE_PlanterBox"]</xpath>
				<value>
					<costList>
						<FSFItemSoil>40</FSFItemSoil>
					</costList>
				</value>
			</li>
				
			</operations>
		</Operation>
			
		</caseTrue>
	</Operation>

</Patch>