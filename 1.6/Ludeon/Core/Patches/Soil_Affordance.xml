<?xml version="1.0" encoding="utf-8"?>

<Patch>

	<Operation Class="PatchOperationSequence">
		<success>Normal</success>
		<operations>
			
	<!-- Stony Soil -->
			
            <li Class="PatchOperationAdd">
                <xpath>/Defs/TerrainDef [(fertility = 0.6 or fertility = 0.7 or fertility = 0.8 or fertility = 0.9) and (not(layerable))] /affordances</xpath>
                    <value>
                        <li>FSFAffordanceSoilStony</li>
                    </value>
            </li>
			
	<!-- Soil -->
			
            <li Class="PatchOperationAdd">
                <xpath>/Defs/TerrainDef [(fertility = 1 or fertility = 1.1 or fertility = 1.2 or fertility = 1.3) and (not(layerable))] /affordances</xpath>
                    <value>
                        <li>FSFAffordanceSoil</li>
                    </value>
            </li>
			
	<!-- Rich Soil -->
			
            <li Class="PatchOperationAdd">
                <xpath>/Defs/TerrainDef [fertility >= 1.4 and not(layerable)] /affordances</xpath>
                    <value>
                        <li>FSFAffordanceSoilRich</li>
                    </value>
            </li>
			
		</operations>
	</Operation>
	
</Patch>